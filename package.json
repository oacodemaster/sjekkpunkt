{
  "name": "sjekkpunkt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:push": "supabase db push",
    "db:seed:build": "tsx scripts/build-seed.ts",
    "db:seed": "tsx scripts/build-seed.ts && sh -c 'set -a; . ./.env.local; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f supabase/seed.sql'",
    "db:users": "tsx scripts/seed-users.ts",
    "voice:setup": "tsx scripts/setup-voice-agents.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "1.21.1",
    "@google/genai": "3.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.20.0"
}
